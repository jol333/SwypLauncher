    <color name="widget_text_color">#18181B</color>
    <color name="widget_text_secondary">#71717A</color>
    <color name="widget_accent">#009966</color>
    <color name="widget_accent_container">#1F00BC7D</color>
    <color name="widget_on_accent">#FFFFFF</color>
