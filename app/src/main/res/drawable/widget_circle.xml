<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined round button. The size is only its aspect ratio: shown with ContentScale.Fit at the
     full height it is given, it stays a circle as large as that height allows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/widget_tile" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_tile_stroke" />
    <size
        android:width="48dp"
        android:height="48dp" />
</shape>
